__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ----------------------------------------------------------------------------
# Model weights — downloaded by subagents / users from HuggingFace, never
# committed. Each ONNX/torch artifact is 5–25 MB; total v3 footprint ~29 MB.
# NOTE: use `models/*` (not `models/`) so per-file negations below work.
# ----------------------------------------------------------------------------
models/*
!models/.gitkeep
# v2 OpenVoice 256-d speaker embeddings (FP16): 5 voices × 512 B + ~344 B
# safetensors header = ~2.9 KB total. Small enough to commit so the v2
# pipeline runs out of the box without re-running offline registration.
!models/voices_v2.safetensors

# ----------------------------------------------------------------------------
# Data fixtures — large wav files (5 voices × 30 s × 24 kHz ≈ 14 MB), may be
# large or contain personal voice data. P1-2 generates synthetic ones locally.
# ----------------------------------------------------------------------------
data/source/*.wav
data/voices/*.wav
data/test/*.wav
!data/.gitkeep
!data/source/.gitkeep
!data/voices/.gitkeep

# ----------------------------------------------------------------------------
# Future v2.0 weights — GGML quantized Rust weights (after src_rust rewrite)
# ----------------------------------------------------------------------------
*.gguf
*.ggml

# ----------------------------------------------------------------------------
# Vendored C/C++ dependencies — downloaded by scripts/vendor_c_deps.sh in the
# P1 v2.0 task; do NOT commit vendored upstream source trees.
# ----------------------------------------------------------------------------
src_c/miniaudio/
src_c/ggml/
src_c/libonnxruntime/

# ----------------------------------------------------------------------------
# Editor / OS / logs
# ----------------------------------------------------------------------------
benchmark.txt
benchmark-report.json
*.log
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
