{
  "p232_p225_001": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "001",
    "text": "Please call Stella.",
    "tgt_duration_s": 2.0515416666666666,
    "src_duration_s": 2.110625,
    "tgt_file": "p232_p225_001.wav",
    "src_file": "p225_p232_001.wav"
  },
  "p232_p225_002": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "002",
    "text": "Ask her to bring these things with her from the store.",
    "tgt_duration_s": 3.9386666666666668,
    "src_duration_s": 3.0772083333333335,
    "tgt_file": "p232_p225_002.wav",
    "src_file": "p225_p232_002.wav"
  },
  "p232_p225_003": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "003",
    "text": "Six spoons of fresh snow peas, five thick slabs of blue cheese, and maybe a snack for her brother Bob.",
    "tgt_duration_s": 7.588166666666667,
    "src_duration_s": 7.507541666666667,
    "tgt_file": "p232_p225_003.wav",
    "src_file": "p225_p232_003.wav"
  },
  "p232_p225_004": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "004",
    "text": "We also need a small plastic snake and a big toy frog for the kids.",
    "tgt_duration_s": 4.411291666666667,
    "src_duration_s": 4.4402083333333335,
    "tgt_file": "p232_p225_004.wav",
    "src_file": "p225_p232_004.wav"
  },
  "p232_p225_005": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "005",
    "text": "She can scoop these things into three red bags, and we will go meet her Wednesday at the train station.",
    "tgt_duration_s": 6.322666666666667,
    "src_duration_s": 6.581958333333334,
    "tgt_file": "p232_p225_005.wav",
    "src_file": "p225_p232_005.wav"
  },
  "p232_p225_006": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "006",
    "text": "When the sunlight strikes raindrops in the air, they act as a prism and form a rainbow.",
    "tgt_duration_s": 7.183166666666667,
    "src_duration_s": 5.4795,
    "tgt_file": "p232_p225_006.wav",
    "src_file": "p225_p232_006.wav"
  },
  "p232_p225_008": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "008",
    "text": "These take the shape of a long round arch, with its path high above, and its two ends apparently beyond the horizon.",
    "tgt_duration_s": 7.647583333333333,
    "src_duration_s": 6.703541666666666,
    "tgt_file": "p232_p225_008.wav",
    "src_file": "p225_p232_008.wav"
  },
  "p232_p225_009": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "009",
    "text": "There is , according to legend, a boiling pot of gold at one end.",
    "tgt_duration_s": 5.284125,
    "src_duration_s": 4.517625,
    "tgt_file": "p232_p225_009.wav",
    "src_file": "p225_p232_009.wav"
  },
  "p232_p225_010": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "010",
    "text": "People look, but no one ever finds it.",
    "tgt_duration_s": 3.22625,
    "src_duration_s": 3.034375,
    "tgt_file": "p232_p225_010.wav",
    "src_file": "p225_p232_010.wav"
  },
  "p232_p225_011": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "011",
    "text": "When a man looks for something beyond his reach, his friends say he is looking for the pot of gold at the end of the rainbow.",
    "tgt_duration_s": 6.82125,
    "src_duration_s": 6.828166666666666,
    "tgt_file": "p232_p225_011.wav",
    "src_file": "p225_p232_011.wav"
  },
  "p232_p225_012": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "012",
    "text": "Throughout the centuries people have explained the rainbow in various ways.",
    "tgt_duration_s": 6.706375,
    "src_duration_s": 4.717666666666666,
    "tgt_file": "p232_p225_012.wav",
    "src_file": "p225_p232_012.wav"
  },
  "p232_p225_013": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "013",
    "text": "Some have accepted it as a miracle without physical explanation.",
    "tgt_duration_s": 4.718708333333334,
    "src_duration_s": 4.277416666666666,
    "tgt_file": "p232_p225_013.wav",
    "src_file": "p225_p232_013.wav"
  },
  "p232_p225_014": {
    "src_speaker": "p232",
    "tgt_speaker": "p225",
    "text_id": "014",
    "text": "To the Hebrews it was a token that there would be no more universal floods.",
    "tgt_duration_s": 5.4442916666666665,
    "src_duration_s": 5.009541666666666,
    "tgt_file": "p232_p225_014.wav",
    "src_file": "p225_p232_014.wav"
  },
